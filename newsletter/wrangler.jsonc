// ivue newsletter Worker — subscribe endpoint, audience + send ledger
// (D1), and a daily cron that drips the back-catalog oldest-unsent-first.
// D1 is the audience layer; Postmark delivers the email (broadcast
// message stream). See README.md for the one-time setup.
{
	"name": "ivue-newsletter",
	"main": "src/index.ts",
	// pinned wrangler 4.120.1's local workerd supports dates up to 2026-08-11
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	// the Worker imports ivue's Static() straight from this repo's source
	"alias": {
		"ivue/extras": "../lib/extras.ts"
	},
	// the admin dashboard (dashboard/ — Vite build) ships as this Worker's
	// static assets; API paths run the Worker first, everything else is the
	// dashboard SPA. Build before deploy: npm run build (from dashboard/).
	"assets": {
		"directory": "dashboard/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/subscribe",
			"/unsubscribe",
			"/broadcast",
			"/drip",
			"/postmark-webhook",
			"/admin/*"
		]
	},
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 }
	},
	"triggers": {
		// hourly drip tick (subscribers are eligible only in the hour
		// matching their LOCAL send-hour setting) + the 5-minute tick
		// that executes due scheduled jobs
		"crons": [
			"0 * * * *",
			"*/5 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ivue-newsletter",
			"database_id": "52fb9196-7b03-494e-a568-88bc4301f0c5",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"SITE_ORIGIN": "https://ivue.dev",
		// this Worker's own public URL — printed on first deploy; used in
		// unsubscribe links (or set a custom route like https://news.ivue.dev)
		"WORKER_ORIGIN": "https://ivue-newsletter.ekalashnikov.workers.dev",
		"SENDER_NAME": "ivue.dev",
		"SENDER_EMAIL": "newsletter@ivue.dev",
		// replies route via Cloudflare Email Routing to a real inbox
		"REPLY_TO": "newsletter@ivue.dev",
		// operator notifications (new-signup pings) — transactional stream
		"NOTIFY_EMAIL": "evgeny@ivue.dev",
		// Postmark message stream for bulk mail — MUST be a Broadcasts stream,
		// never the transactional default ("outbound")
		"POSTMARK_STREAM": "newsletter",
		// drip clock defaults (D1 settings override without a deploy):
		// every N calendar days, at hour H in the subscriber's own zone
		"CADENCE_DAYS": "2",
		"SEND_HOUR_LOCAL": "9",
		// stand-in zone for subscribers with no captured timezone
		"DEFAULT_TIMEZONE": "America/Toronto",
		// Turnstile: hostnames the widget may report (frontend origins).
		// Verification activates when the TURNSTILE_SECRET secret is set.
		"TURNSTILE_HOSTNAMES": "ivue.dev"
	}
	// secrets (set via: npx wrangler@4.120.1 secret put <NAME>):
	//   POSTMARK_SERVER_TOKEN — Postmark → your server → API Tokens
	//   ADMIN_SECRET          — long random string; authorizes /broadcast and
	//                           signs unsubscribe tokens
}